{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true, "types": ["vite/client", "node"],
    "paths": {"@/*": ["../web/src/*"]}
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"]
}
